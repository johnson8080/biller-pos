rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    // The developer: the only account that may read the list of accounts.
    function isOwner() { return email() == 'johnsonommala1@gmail.com'; }

    // --- The shop -------------------------------------------------------
    // One document per account. The shop follows the account, not the
    // device: sign in on another phone and the same shop comes with you.
    match /billerShops/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
    }

    // --- Presence -------------------------------------------------------
    // Each account writes only its own record (email, app version, last
    // seen, online flag). The owner reads the whole list. Admin deletion
    // is reserved for the developer and the shopkeeper themselves.
    match /billerPresence/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // --- Payment requests -----------------------------------------------
    // A shop asks for its monthly plan to be confirmed after paying. The
    // shop creates and reads its own request; only the developer answers it.
    match /billerPayments/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && (request.auth.uid == uid || isOwner());
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.status == 'pending') ||
        isOwner()
      );
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
    }

    // --- Announcements (developer -> every shop) -------------------------
    // The developer publishes; every signed-in shop can read the list.
    match /billerAnnouncements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && isOwner();
    }
    // One read receipt per shop per announcement, written the moment the
    // shop opens the announcements page. Immutable: the developer audits
    // who opened what, and shops never edit each other's receipts.
    match /billerAnnouncementReads/{id} {
      allow read: if signedIn() && isOwner();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && (request.auth.uid == resource.data.uid || isOwner());
    }
  }
}
